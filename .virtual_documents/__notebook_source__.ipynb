def clean_text(text: str) -> str:
    """Minimal text cleaning — lowercase, remove URLs, normalise whitespace."""
    text = text.lower()
    text = re.sub(r"http\S+|www\S+", "", text)   # remove URLs
    text = re.sub(r"\s+", " ", text).strip()      # normalise spaces
    return text


