                Vocab {MAX_VOCAB:,}
            </span>
            <span class="badge badge-slate">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                {str(DEVICE).upper()}
            </span>
            <span class="badge badge-blue">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                PyTorch
            </span>
        </div>
    </div>
    """)

    # ── Main body ──
    with gr.Row(equal_height=False):

        # Left column — input
        with gr.Column(scale=3):
            gr.HTML(f"""<div class="section-label">{ICON_TEXT} Input Text</div>""")
            input_text = gr.Textbox(
                label="",
                placeholder="Paste or type any text to analyse for hate speech content…",
                lines=7,
                max_lines=14,
                show_label=False,
            )
            with gr.Row():
                submit_btn = gr.Button(
                    "Analyse Text", variant="primary", size="lg", scale=3
                )
                clear_btn = gr.ClearButton(
                    [input_text], value="Clear", size="lg", scale=1
                )

        # Right column — output
        with gr.Column(scale=2):
            gr.HTML(f"""<div class="section-label">{ICON_BAR} Analysis Result</div>""")
            output_html = gr.HTML(
                value="""
                <div style='padding:32px;text-align:center;color:#64748b;font-family:DM Sans,sans-serif;font-size:14px;border:1.5px dashed rgba(61,135,255,0.15);border-radius:12px;'>
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="1.5" style="margin:0 auto 10px;display:block;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    Result will appear here
                </div>""",
                label="",
                show_label=False,
            )
            gr.HTML(f"""<div class="section-label" style="margin-top:16px;">{ICON_BEAM} Confidence Scores</div>""")
            output_conf = gr.Label(
                label="",
                num_top_classes=2,
                show_label=False,
            )

    # ── Examples ──
    gr.HTML("""<div class="section-label" style="margin-top:8px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        Quick Examples
    </div>""")
    gr.Examples(
        examples=[
            ["I love spending time with my friends and family on the weekend."],
            ["This is a normal conversation about the weather in Kolkata today."],
            ["Let's work together to build a stronger and more inclusive community."],
            ["Thank you for your support — it genuinely means a lot to me."],
        ],
        inputs=input_text,
        label="",
    )

    # ── Footer ──
    gr.HTML(f"""
    <div id="footer-band" style="margin-top:24px;">
        <div class="footer-grid">
