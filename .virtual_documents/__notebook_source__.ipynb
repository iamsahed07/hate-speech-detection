            <div class="footer-stat">
                <div class="footer-stat-val">{MAX_LEN}</div>
                <div class="footer-stat-label">Max Tokens</div>
            </div>
            <div class="footer-stat">
                <div class="footer-stat-val">{NUM_LAYERS}×2</div>
                <div class="footer-stat-label">GRU Layers</div>
            </div>
        </div>
        <div class="footer-note">
            AI classifier — use as a moderation aid, not a sole decision-maker. &nbsp;·&nbsp;
            Architecture: Embedding → BiGRU ×{NUM_LAYERS} → Mean-pool → Linear
        </div>
    </div>
    """)

    # ── Event wiring ──
    submit_btn.click(
        fn=predict_hate_speech,
        inputs=input_text,
        outputs=[output_html, output_conf],
    )
    input_text.submit(
        fn=predict_hate_speech,
        inputs=input_text,
        outputs=[output_html, output_conf],
    )

