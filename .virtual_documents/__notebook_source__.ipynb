class BiGRUClassifier(nn.Module):
    """
    Bidirectional GRU classifier for binary text classification.

    Architecture:
        Embedding → BiGRU (stacked) → Mean-pool → Dropout → Dense → Output
    """

    def __init__(
        self,
        vocab_size:  int,
        embed_dim:   int   = EMBED_DIM,
        hidden_dim:  int   = HIDDEN_DIM,
        num_layers:  int   = NUM_LAYERS,
        num_classes: int   = 2,
        dropout:     float = DROPOUT,
        pad_idx:     int   = 0,
    ) -> None:
        super().__init__()

        self.embedding = nn.Embedding(
            vocab_size, embed_dim, padding_idx=pad_idx
        )
        self.bigru = nn.GRU(
            input_size=embed_dim,
            hidden_size=hidden_dim,
            num_layers=num_layers,
            batch_first=True,
            bidirectional=True,
            dropout=dropout if num_layers > 1 else 0.0,
        )
        self.dropout = nn.Dropout(dropout)
        self.fc = nn.Linear(hidden_dim * 2, num_classes)  # *2 for bidirectional

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        # x: (batch, seq_len)
        embedded = self.dropout(self.embedding(x))          # (batch, seq_len, embed_dim)
        gru_out, _ = self.bigru(embedded)                   # (batch, seq_len, hidden*2)
        pooled = gru_out.mean(dim=1)                        # mean pool over time
        out = self.fc(self.dropout(pooled))                 # (batch, num_classes)
        return out


