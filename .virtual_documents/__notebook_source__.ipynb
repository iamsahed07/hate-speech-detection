    border-radius: var(--radius-lg);
    padding: 28px 24px;
    text-align: center;
    box-shadow: var(--shadow-card);
    position: relative;
    overflow: hidden;
}
.result-card-safe {
    background: linear-gradient(135deg, rgba(16,185,129,0.12) 0%, rgba(4,13,26,0.8) 100%);
    border: 1.5px solid rgba(52,211,153,0.3);
}
.result-card-hate {
    background: linear-gradient(135deg, rgba(239,68,68,0.12) 0%, rgba(4,13,26,0.8) 100%);
    border: 1.5px solid rgba(248,113,113,0.3);
}
.result-icon { width: 52px; height: 52px; margin: 0 auto 12px; }
.result-title { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
.result-title-safe  { color: var(--green-400); }
.result-title-hate  { color: var(--red-400); }
.result-conf  { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--slate-400); }
.result-bar-wrap { margin-top: 16px; background: rgba(4,13,26,0.5); border-radius: 999px; height: 6px; }
.result-bar { height: 6px; border-radius: 999px; transition: width 0.6s cubic-bezier(.4,0,.2,1); }
.result-bar-safe { background: linear-gradient(90deg, var(--green-500), var(--cyan-400)); }
.result-bar-hate { background: linear-gradient(90deg, var(--red-500), #f97316); }

/* ── Examples section ── */
.gradio-container .examples-holder {
    background: var(--glass-bg) !important;
    border: 1px solid var(--glass-border) !important;
    border-radius: var(--radius-lg) !important;
}
.gradio-container .examples-holder button {
    background: rgba(29,110,245,0.08) !important;
    border: 1px solid rgba(29,110,245,0.15) !important;
    border-radius: var(--radius-sm) !important;
    color: var(--slate-300) !important;
    font-size: 13px !important;
    transition: background 0.15s, border-color 0.15s !important;
}
.gradio-container .examples-holder button:hover {
    background: rgba(29,110,245,0.18) !important;
    border-color: var(--blue-400) !important;
    color: var(--white) !important;
}

/* ── Footer ── */
#footer-band {
    background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-800) 100%);
    border-top: 1px solid var(--glass-border);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    padding: 20px 40px;
}
.footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}
.footer-stat {
    text-align: center;
    padding: 12px;
    background: rgba(29,110,245,0.06);
    border: 1px solid rgba(29,110,245,0.1);
    border-radius: var(--radius-md);
}
.footer-stat-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 18px;
    font-weight: 500;
    color: var(--blue-300);
}
.footer-stat-label {
    font-size: 11px;
    color: var(--slate-500);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-top: 2px;
}
.footer-note {
    font-size: 12px;
    color: var(--slate-500);
    text-align: center;
    margin-top: 16px;
    line-height: 1.6;
}
.footer-note a { color: var(--blue-300); text-decoration: none; }

/* ── Confidence bar component ── */
.gradio-container .label-wrap { background: transparent !important; }

/* ── Scrollbar ── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--navy-900); }
::-webkit-scrollbar-thumb { background: var(--navy-600); border-radius: 3px; }
