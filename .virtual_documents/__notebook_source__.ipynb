# ── Predict function ──────────────────────────────────────────────────────────
def predict_hate_speech(text: str):
    """Predict whether input text contains hate speech."""
    if not text.strip():
        empty_html = """
        <div style='padding:32px;text-align:center;color:#64748b;font-family:DM Sans,sans-serif;font-size:14px;'>
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" style="margin:0 auto 12px;display:block;">
                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
            </svg>
            Enter some text above and press Analyse
        </div>"""
        return empty_html, None

    cleaned = clean_text(text)
    ids = torch.tensor(
        [_tokenizer.encode(cleaned, max_len=MAX_LEN)], dtype=torch.long
    ).to(DEVICE)

    with torch.no_grad():
        logits = _model(ids)
        probs  = torch.softmax(logits, dim=1)[0].cpu().numpy()

    prediction = int(np.argmax(probs))
    confidence = float(probs[prediction])
    bar_pct    = int(confidence * 100)

    if prediction == 1:
        card_cls   = "result-card-hate"
        title_cls  = "result-title-hate"
        bar_cls    = "result-bar-hate"
        icon_svg   = f'<div style="color:#f87171;">{ICON_ALERT}</div>'
        title_text = "Hate Speech Detected"
        conf_label = "Detection confidence"
    else:
        card_cls   = "result-card-safe"
        title_cls  = "result-title-safe"
        bar_cls    = "result-bar-safe"
        icon_svg   = f'<div style="color:#34d399;">{ICON_SAFE}</div>'
        title_text = "Content is Safe"
        conf_label = "Safety confidence"

    result_html = f"""
    <div class="result-card {card_cls}" style="font-family:'DM Sans',sans-serif;">
        <div class="result-icon">{icon_svg}</div>
        <div class="result-title {title_cls}">{title_text}</div>
        <div class="result-conf">{conf_label} &nbsp;·&nbsp; <span style="color:#cbd5e1;font-weight:600;">{confidence:.1%}</span></div>
        <div class="result-bar-wrap">
            <div class="result-bar {bar_cls}" style="width:{bar_pct}%;"></div>
        </div>
    </div>"""

    confidence_dict = {
        "Non-Hate Speech": float(probs[0]),
        "Hate Speech":     float(probs[1]),
    }

    return result_html, confidence_dict


